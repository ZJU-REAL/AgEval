# Copy to services/registry/.env (gitignored) and fill secrets.

BORA_GITHUB_CLIENT_ID=
BORA_GITHUB_CLIENT_SECRET=

BORA_REGISTRY_DATABASE_URL=postgresql://bora:bora@127.0.0.1:5433/bora_registry

BORA_REGISTRY_S3_ENDPOINT=http://127.0.0.1:9000
BORA_REGISTRY_S3_ACCESS_KEY=bora
BORA_REGISTRY_S3_SECRET_KEY=boraborabora
BORA_REGISTRY_S3_BUCKET=bora
BORA_REGISTRY_S3_REGION=us-east-1

BORA_REGISTRY_HOST=127.0.0.1
BORA_REGISTRY_PORT=8700
