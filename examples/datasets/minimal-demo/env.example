# Copy to .env and fill locally. Never commit real keys.
glm_coding_api_key=
litellm_api_key=
litellm_base_url=
# ZAI_CODING_CN_API_KEY projected from locator when configured.
# dsh plugin locator (runtime projects DEEPSEEK_API_KEY).
deepseek_api_key=

# ssh A/B locators. AGEVAL_SSH_KEY is the private-key *path*, not the key bytes.
AGEVAL_SSH_HOST=
AGEVAL_SSH_USER=
AGEVAL_SSH_PORT=
AGEVAL_SSH_KEY=
