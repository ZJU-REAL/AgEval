# Layer nooa in-container worker onto a package Attempt image.
# Build context = installed nooa plugin package root (path install cache).
# Usage (host):
#   docker build --build-arg BASE_IMAGE=<pkg-tag> -f docker/Dockerfile.bake -t <out> .
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root
COPY src/nooa_plugin /opt/nooa/nooa_plugin
COPY worker/bora_executor_nooa.py /usr/local/bin/bora-executor-nooa
RUN chmod 755 /usr/local/bin/bora-executor-nooa \
    && test -f /usr/local/bin/bora-executor-nooa \
    && python3 -m py_compile /usr/local/bin/bora-executor-nooa

# Prefer non-root actor when base defines it.
USER bora
WORKDIR /attempt/workspace
